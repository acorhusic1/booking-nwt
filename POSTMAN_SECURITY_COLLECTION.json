      "name": "1. AUTENTIFIKACIJA - LOGIN",
      "item": [
        {
          "name": "1.1 Login - GUEST korisnik",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    let response = pm.response.json();",
                  "    pm.environment.set('guest_token', response.accessToken);",
                  "    pm.environment.set('guest_email', response.email);",
                  "    pm.environment.set('guest_role', response.role);",
                  "    console.log('✅ GUEST Login uspješan!');",
                  "    console.log('Token: ' + response.accessToken.substring(0, 20) + '...');",
                  "    console.log('Role: ' + response.role);",
                  "} else {",
                  "    console.log('❌ Login neuspješan');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guest@example.com\",\n  \"password\": \"guest123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
