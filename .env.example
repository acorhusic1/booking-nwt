# BookingNWT environment variables
# Kopiraj ovaj fajl u `.env` i popuni stvarne vrijednosti.
# `.env` je ignorisan kroz .gitignore — nikad ne commit-uj ključeve!

# ─── Stripe Checkout (test mode) ────────────────────────────────────────
# Dohvati svoj test secret key na: https://dashboard.stripe.com/test/apikeys
# Pocinje sa "sk_test_..."
# Detaljno uputstvo: docs/STRIPE_SETUP.md
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Opciono — URL-ovi gdje Stripe redirektuje korisnika nakon placanja.
# Default vrijednosti rade za lokalni docker setup.
# STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?stripe_session={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/dashboard?stripe_cancelled=1
