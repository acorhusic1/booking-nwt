version: '3.8'

services:
  # Druga instanca property-service za load balancing test
  property-service-2:
    image: booking-nwt/property-service:latest
    container_name: property-service-2
    ports:
      - "8092:8082"  # Mapiraj na port 8092
    environment:
      - SERVER_PORT=8082
      - SPRING_PROFILES_ACTIVE=docker
    depends_on:
      - mysql-db
      - eureka-server
      - config-server
    restart: unless-stopped

  # Treća instanca property-service za load balancing test
  property-service-3:
    image: booking-nwt/property-service:latest
    container_name: property-service-3
    ports:
      - "8093:8082"  # Mapiraj na port 8093
    environment:
      - SERVER_PORT=8082
      - SPRING_PROFILES_ACTIVE=docker
    depends_on:
      - mysql-db
      - eureka-server
      - config-server
    restart: unless-stopped
